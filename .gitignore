# ---------------------------------------------------------------------------
# PRIVACY FIRST. Real statements and their passwords must never be committed.
# See fixtures/README.md. Only redacted, synthetic fixtures belong in git.
# ---------------------------------------------------------------------------
fixtures/statements/raw/
fixtures/glyphs/raw/
fixtures/**/*.pdf
!fixtures/statements/redacted/*.pdf
secrets/
*.password
*.passwords
hints.local.*

# Dart / Flutter
.dart_tool/
.packages
build/
pubspec.lock
!app/pubspec.lock
.flutter-plugins
.flutter-plugins-dependencies
.melos_tool/
melos_*.iml
# Regenerated by `melos bootstrap`; contains machine-local absolute-ish paths.
pubspec_overrides.yaml
coverage/
doc/api/
*.g.dart.bak

# Generated sources are committed on purpose (freezed/json_serializable/drift)
# so CI and reviewers do not need build_runner. Do NOT ignore *.g.dart / *.freezed.dart.

# Android
app/android/.gradle/
app/android/local.properties
app/android/key.properties
*.jks
*.keystore

# iOS
app/ios/Pods/
app/ios/.symlinks/
app/ios/Flutter/Flutter.framework
app/ios/Flutter/Flutter.podspec

# Python (tools/rule_extraction)
__pycache__/
*.pyc
.venv/
venv/

# Editors / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
